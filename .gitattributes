# 在 GitHub 页面正确显示统计信息
*.md linguist-vendored=false
*.md linguist-generated=false
*.md linguist-documentation=false
*.md linguist-detectable=true
# 默认启用文本自动规范化：入库（提交）与检出（下载）一律 LF
* text=auto eol=lf
# 明确指定 Markdown / 文本使用 LF
*.md  text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.tsv text eol=lf
*.jsonl text eol=lf
*.claim text eol=lf
*.sql text eol=lf
*.py  text eol=lf
*.sh  text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
*.html text eol=lf
*.mjs  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.toml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.textlintrc text eol=lf
.autocorrectrc text eol=lf
LICENSE text eol=lf
.yamllint text eol=lf
