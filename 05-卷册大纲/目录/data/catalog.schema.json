{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "catalog.schema.json",
  "title": "BSD 史目录页语义数据中枢（catalog）",
  "description": "05-卷册大纲/目录 DATA 段的枚举化数据源。发布态单体 HTML 由 embed.py 装配本文件与 index.html 的 var DATA 行。",
  "type": "object",
  "required": ["$schema", "version", "persons", "refs", "revs"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "const": "catalog.schema.json" },
    "version": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "persons": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/person" }
    },
    "refs": {
      "type": "object",
      "description": "文献编号（ref N 或 SRC-mat:N）到 GB/T 7714 著录的映射",
      "additionalProperties": { "type": "string" }
    },
    "revs": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 4,
        "maxItems": 4,
        "items": [
          { "type": "string", "pattern": "^\\d+$" },
          { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          { "type": "string", "minLength": 1 },
          { "type": "string", "minLength": 1 }
        ]
      }
    }
  },
  "$defs": {
    "person": {
      "type": "object",
      "required": ["id", "names", "role", "priority", "volume", "status", "affiliations"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^p-\\d{4,}$" },
        "names": {
          "type": "object",
          "required": ["zh", "en"],
          "additionalProperties": false,
          "properties": {
            "zh": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 },
              "description": "中文译名与中译变体（至少 1 个）"
            },
            "en": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 },
              "description": "英文原名与昵称/账户变体（至少 1 个）"
            }
          }
        },
        "accounts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "freebsd": { "type": ["string", "null"] },
            "netbsd": { "type": ["string", "null"] },
            "openbsd": { "type": ["string", "null"] },
            "dragonflybsd": { "type": ["string", "null"] },
            "legacy": { "type": ["string", "null"], "description": "person_id_legacy 类历史标识（保留溯源性）" }
          }
        },
        "role": { "type": "string", "minLength": 1 },
        "priority": { "enum": ["P0", "P1", "P2"] },
        "volume": { "type": "string", "pattern": "^\\d+(\\.\\d+)?$" },
        "status": {
          "type": "object",
          "required": ["alive"],
          "additionalProperties": false,
          "properties": {
            "alive": { "type": "boolean" },
            "birth": { "type": ["string", "null"], "pattern": "^\\d{4}(-\\d{2}-\\d{2})?$" },
            "death": { "type": ["string", "null"], "pattern": "^\\d{4}(-\\d{2}-\\d{2})?$" },
            "note": { "type": "string", "default": "" }
          }
        },
        "affiliations": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
